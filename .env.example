# Dados públicos do projeto Supabase.
NEXT_PUBLIC_SUPABASE_URL="https://SEU-PROJETO.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="SUA_CHAVE_PUBLICÁVEL_OU_ANON"

# Google Places API (New). Usada somente pelo servidor da Vercel.
GOOGLE_PLACES_API_KEY="SUA_CHAVE_DO_GOOGLE_PLACES"

# Chave separada para exibir o mapa no navegador. Restrinja por domínio HTTP.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="SUA_CHAVE_DO_MAPS_JAVASCRIPT"

# Necessária apenas para o servidor ler as chaves cadastradas na Administração.
# Aceita a chave Secret atual ou a Service Role legada. Nunca use NEXT_PUBLIC_.
SUPABASE_SECRET_KEY="SUA_CHAVE_SECRET_DO_SUPABASE"
